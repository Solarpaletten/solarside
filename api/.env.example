# ===========================================================================
# SOLAR CORE — Environment Configuration
# ===========================================================================
# Скопируй в .env и заполни значения:
#   cp .env.example .env

# --- Application ---
SOLAR_ENV=development              # development | staging | production
SOLAR_DEBUG=true
SOLAR_LOG_LEVEL=INFO
SOLAR_API_HOST=0.0.0.0
SOLAR_API_PORT=8000

# --- Security ---
SOLAR_SECRET_KEY=change-me-to-something-random-please
SOLAR_API_KEYS=dev-key-1,dev-key-2  # comma-separated, для simple auth на старте

# --- Database ---
# Для разработки можно использовать SQLite:
SOLAR_DATABASE_URL=sqlite+aiosqlite:///./solar_core.db

# Для production — PostgreSQL (твой Ubuntu сервер):
# SOLAR_DATABASE_URL=postgresql+asyncpg://solar_user:PASSWORD@localhost:5433/solarerp

# --- AI Providers ---
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=                  # опционально
OPENAI_API_KEY=                    # опционально, fallback

# --- AI Routing ---
# Какой провайдер использовать по умолчанию для разных задач
SOLAR_AI_DEFAULT_PROVIDER=anthropic
SOLAR_AI_REASONING_MODEL=claude-sonnet-4-6
SOLAR_AI_EXTRACTION_MODEL=claude-haiku-4-5-20251001
SOLAR_AI_FALLBACK_PROVIDER=openai

# --- Connectors ---
SOLAR_ERP_BASE_URL=http://localhost:3000        # SOLAR ERP (Prisma backend)
SOLAR_ERP_API_KEY=

# --- Vector search ---
SOLAR_EMBEDDINGS_MODEL=text-embedding-3-small   # для pgvector
SOLAR_EMBEDDINGS_DIMENSION=1536
